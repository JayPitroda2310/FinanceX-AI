{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs22.x"
    }
  },
  "routes": [
    {
      "src": "^/api/chat/?$",
      "dest": "/api/chat/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^(?:/)?$",
      "dest": "/index.html"
    },
    {
      "src": "^(?!/api/).*$",
      "dest": "/index.html"
    }
  ]
}
