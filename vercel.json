{
  "version": 2,
  "builds": [
    {
      "src": "api/chat/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "finance-ai-chatbot.html",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.webmanifest",
      "use": "@vercel/static"
    },
    {
      "src": "service-worker.js",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/api/chat/?$",
      "dest": "/api/chat/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^(?:/)?$",
      "dest": "/index.html"
    },
    {
      "src": "^(?!/api/).*$",
      "dest": "/index.html"
    }
  ]
}
